<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Productos</title>
    <style>
        body { margin: 0; font-family: Arial, sans-serif; background-color: #f4f4f4; }
        .container { padding: 20px; max-width: 1200px; margin: 0 auto; }
        table { width: 100%; border-collapse: collapse; background: white; margin-top: 20px; }
        th, td { padding: 12px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #333; color: white; }
        .btn { padding: 8px 12px; text-decoration: none; color: white; border-radius: 4px; border: none; cursor: pointer; }
        .btn-nuevo { background-color: #28a745; display: inline-block; margin-bottom: 15px; }
        .btn-editar { background-color: #007bff; }
        .btn-baja { background-color: #ffc107; color: #000; }
        .btn-alta { background-color: #28a745; }
        .btn-eliminar { background-color: #dc3545; }
        img.miniatura { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; }

        /* Estilos del Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: white;
            padding: 25px;
            border-radius: 8px;
            width: 380px;
            text-align: center;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
        }
        .modal-actions {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 15px;
        }
    </style>
</head>
<body>

    <!-- Subimos un nivel en la carpeta para encontrar el nav.ejs -->
    <%- include('../nav') %>

    <div class="container">
        <h2>Catálogo de Productos</h2>
        <% if (adminLogueado) { %>
            <a href="/productos/nuevo" class="btn btn-nuevo">+ Agregar Nuevo Producto</a>
        <% } %>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Categoría</th>
                    <th>Estado</th>
                    <% if (adminLogueado) { %><th>Acciones</th><% } %>
                </tr>
            </thead>
            <tbody>
                <!-- Recorremos el array de productos que enviará el controlador -->
                <% if (typeof productos !== 'undefined' && productos.length > 0) { %>
                    <% productos.forEach(producto => { %>
                        <tr>
                            <td><%= producto.id %></td>
                            <td>
                                <img src="/imagenes/<%= producto.imagen || 'default.png' %>" class="miniatura" alt="Imagen producto">
                            </td>
                            <td><%= producto.nombre %></td>
                            <td>$<%= producto.precio %></td>
                            <td><%= producto.stock %></td>
                            <td><%= producto.categoria %></td>
                            <% if (adminLogueado) { %>
                            <td>
                                <!-- Verificamos si está dado de baja o activo -->
                                <% if (producto.activo !== false) { %>
                                    <span style="color: green; font-weight: bold;">Activo</span>
                                <% } else { %>
                                    <span style="color: red; font-weight: bold;">Inactivo</span>
                                <% } %>
                            </td>
                            <% } %>
                            
                            <% if (adminLogueado) { %>
                            <td>
                                <div style="display: flex; gap: 5px; align-items: center; flex-wrap: wrap;">
                                    <a href="/productos/editar/<%= producto.id %>" class="btn btn-editar">Editar</a>
                                    
                                    <!-- Botones de baja, alta y eliminar con modal de confirmación -->
                                    <% if (producto.activo !== false) { %>
                                        <button type="button" class="btn btn-baja" onclick="abrirModal('desactivar', '<%= producto.id %>', '<%= producto.nombre %>')">Desactivar</button>
                                    <% } else { %>
                                        <button type="button" class="btn btn-alta" onclick="abrirModal('reactivar', '<%= producto.id %>', '<%= producto.nombre %>')">Activar</button>
                                    <% } %>

                                    <button type="button" class="btn btn-eliminar" onclick="abrirModal('eliminar', '<%= producto.id %>', '<%= producto.nombre %>')">Eliminar</button>
                                </div>
                            </td>
                            <% } %>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="<%= adminLogueado ? 8 : 7 %>" style="text-align: center;">No hay productos cargados en la base de datos.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Modal de Confirmación Único y Dinámico -->
    <div id="modalConfirmacion" class="modal-overlay">
        <div class="modal-content">
            <h3 id="tituloModal">¿Estás seguro?</h3>
            <p id="textoProducto" style="color: #555; margin: 10px 0 20px 0;"></p>
            <form id="formAccion" method="POST">
                <div class="modal-actions">
                    <button type="button" class="btn" style="background-color: #6c757d;" onclick="cerrarModal()">Cancelar</button>
                    <button type="submit" id="btnConfirmar" class="btn">Confirmar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function abrirModal(accion, id, nombre) {
            const modal = document.getElementById("modalConfirmacion");
            const form = document.getElementById("formAccion");
            const titulo = document.getElementById("tituloModal");
            const texto = document.getElementById("textoProducto");
            const btnConfirmar = document.getElementById("btnConfirmar");

            texto.textContent = `Producto: "${nombre}"`;

            if (accion === 'desactivar') {
                titulo.textContent = "¿Estás seguro de desactivarlo?";
                form.action = `/productos/desactivar/${id}`;
                btnConfirmar.className = "btn btn-baja";
                btnConfirmar.style.color = "#000";
                btnConfirmar.textContent = "Sí, desactivar";
            } else if (accion === 'reactivar') {
                titulo.textContent = "¿Estás seguro de activarlo?";
                form.action = `/productos/reactivar/${id}`;
                btnConfirmar.className = "btn btn-alta";
                btnConfirmar.style.color = "#fff";
                btnConfirmar.textContent = "Sí, activar";
            } else if (accion === 'eliminar') {
                titulo.textContent = "¿Estás seguro de eliminarlo?";
                form.action = `/productos/eliminar/${id}`;
                btnConfirmar.className = "btn btn-eliminar";
                btnConfirmar.style.color = "#fff";
                btnConfirmar.textContent = "Sí, eliminar";
            }

            modal.style.display = "flex";
        }

        function cerrarModal() {
            document.getElementById("modalConfirmacion").style.display = "none";
        }
    </script>

</body>
</html>